# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=saarthi_ai

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# LLM Provider: "mock" or "gemini" or "openai"
LLM_PROVIDER=mock

# API Key (only needed if LLM_PROVIDER is not "mock")
LLM_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
